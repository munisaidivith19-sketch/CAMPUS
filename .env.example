# =============================================================================
# CampusConnect — Environment Configuration (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit `.env`. NEVER place any of these secrets in frontend code.
# All secrets are backend-only. The web/mobile apps receive ONLY the
# VITE_*/EXPO_PUBLIC_* variables at the bottom, which are safe to expose.
#
# Phase 1 note: this file lists the variables the FROZEN architecture will
# consume. Only variables the running code actually reads should remain as
# features land. See docs/API_KEYS.md for how to obtain each external key
# and its free/local alternative.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Port the Express API listens on
PORT=4000
# Public base URL of the API (used for links in emails, QR verification, etc.)
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed web origins for CORS (NO wildcards in prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006
# API version prefix
API_VERSION=v1

# --- Database: MongoDB (SOLE primary database) -------------------------------
# Local Docker default below. Use a replica set in prod for transactions.
MONGODB_URI=mongodb://localhost:27017/campusconnect
# Optional dedicated DB name override (otherwise taken from the URI path)
MONGODB_DB_NAME=campusconnect

# --- Redis (infrastructure only: rate limiting, cache, queues, sessions) -----
# OPTIONAL for local dev. Leave blank to disable Redis-backed features and
# fall back to in-memory equivalents where safe (documented per feature).
# REQUIRED in any deployment running more than one API instance: rate-limit
# counters are per-process without it. If Redis is unreachable the limiters
# fail open to the in-process counter and log a warning (docs/security).
REDIS_URL=redis://localhost:6379

# --- Authentication / Sessions (REQUIRED from Phase 2 on) --------------------
# The API refuses to boot without these. Generate strong random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters each, and they must differ from one another.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Argon2id tuning (see docs/security). Higher = slower = safer.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Institution email enforcement (backend-enforced, never frontend-only) ---
# Only addresses on this domain may register/authenticate.
COLLEGE_EMAIL_DOMAIN=jnn.edu.in

# --- Email (local dev uses Mailpit; no real SMTP credentials needed) ---------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="CampusConnect <no-reply@jnn.edu.in>"
# Public origin of the web app — used to build links inside verification/reset emails.
WEB_APP_URL=http://localhost:5173

# --- Notification delivery (Phase 3 Part B) ----------------------------------
# In-app notification rows are always written. These control the ADDITIONAL
# out-of-band channels (email + push); disabling them never suppresses the row.
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_BACKOFF_MS=500
# How often a worker polls the shared queue for another instance's (or a crashed
# worker's) deliveries. Local enqueues drain immediately.
NOTIFICATION_DELIVERY_POLL_MS=5000

# Push provider: `none` (default) or `expo`.
# `none` = NOT CONFIGURED: nothing is sent, attempts are recorded as skipped.
PUSH_PROVIDER=none
PUSH_API_URL=https://exp.host/--/api/v2/push/send
# Optional. Expo push works without one for basic use; leave blank if unused.
# NEVER commit a real token — this file ships placeholders only.
EXPO_ACCESS_TOKEN=

# --- File storage & malware scanning (Phase 3/4) -----------------------------
# Local disk root for uploads in dev. Path is OUTSIDE the web root and
# served only through authorized, signed download endpoints.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_BYTES=26214400
# ClamAV daemon (clamd) — provided by the `clamav` docker service.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# --- AI provider abstraction (Phase 5). NOT CONFIGURED by default. -----------
# AI_PROVIDER: one of `none` | `gemini` | `ollama`
AI_PROVIDER=none
# Only used when AI_PROVIDER=gemini (free tier available)
GEMINI_API_KEY=
# Only used when AI_PROVIDER=ollama (fully local, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Job/Internship provider abstraction (Phase 4). NOT CONFIGURED. ----------
# Keys stay server-side only and are never sent to any frontend.
JOB_PROVIDER=none
JOB_API_KEY=

# --- Maps (Phase 4): OpenStreetMap + Leaflet need NO key/token ---------------
# Tile server URL (default OSM). No secret required.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Observability / error tracking (optional) -------------------------------
# Leave blank to disable. Sentry has a free tier.
SENTRY_DSN=
LOG_LEVEL=info

# =============================================================================
# FRONTEND-SAFE variables ONLY below this line.
# Vite (web) exposes VITE_*; Expo (mobile) exposes EXPO_PUBLIC_*.
# Do NOT put secrets here — anything below ships to the browser/app bundle.
# =============================================================================
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_APP_NAME=CampusConnect

EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_APP_NAME=CampusConnect
